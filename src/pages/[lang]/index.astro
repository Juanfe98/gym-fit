---
import type { GetStaticPaths } from 'astro';
import type { Goal } from '../../types';
import { ROUTINES } from '../../data/routines/index';
import GoalCard from '../../components/GoalCard.astro';
import { languages, type Language, localizePath } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getGoalDisplayName } from '../../i18n/content';
import '../../styles/global.css';

export const getStaticPaths = (() => languages.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Language;
const t = useTranslations(lang);

const goals = (Object.keys(ROUTINES) as Goal[]).map((slug) => ({
  goal: slug,
  displayName: getGoalDisplayName(slug, lang),
  href: localizePath(lang, `/routine/${slug}`),
}));

const labels = {
  programs:      lang === 'es' ? 'Programas'  : 'Programs',
  exercises:     lang === 'es' ? 'Ejercicios' : 'Exercises',
  days:          lang === 'es' ? 'Días/semana': 'Days/week',
  selectPrompt:  lang === 'es' ? 'Elige tu entrenamiento' : 'Choose your training',
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t('homeDescription')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{t('chooseGoalTitleMeta')}</title>
  </head>

  <body class="min-h-screen bg-gym-bg text-gym-text overflow-x-hidden">

    <!-- ── HERO ─────────────────────────────────────────────── -->
    <section class="relative">

      <!-- Subtle grid texture -->
      <div
        aria-hidden="true"
        class="absolute inset-0 pointer-events-none"
        style="
          background-image:
            linear-gradient(rgba(248,250,252,0.04) 1px, transparent 1px),
            linear-gradient(90deg, rgba(248,250,252,0.04) 1px, transparent 1px);
          background-size: 44px 44px;
        "
      />

      <!-- Accent glow (top-left) -->
      <div
        aria-hidden="true"
        class="absolute -top-20 -left-10 w-72 h-72 pointer-events-none rounded-full"
        style="background: radial-gradient(circle, rgba(249,115,22,0.14) 0%, transparent 65%);"
      />

      <!-- Bottom fade into page bg -->
      <div
        aria-hidden="true"
        class="absolute inset-x-0 bottom-0 h-28 pointer-events-none"
        style="background: linear-gradient(to bottom, transparent, #0F172A);"
      />

      <div class="relative px-5 pt-6 pb-16">

        <!-- Language switcher -->
        <nav class="flex justify-end mb-10" aria-label="Language">
          <div class="inline-flex items-center gap-1 bg-gym-surface border border-gym-border rounded-lg p-1">
            <a
              href="/en"
              class={`text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md transition-colors duration-200 ${lang === 'en' ? 'bg-gym-border text-gym-text' : 'text-gym-muted'}`}
            >EN</a>
            <a
              href="/es"
              class={`text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md transition-colors duration-200 ${lang === 'es' ? 'bg-gym-border text-gym-text' : 'text-gym-muted'}`}
            >ES</a>
          </div>
        </nav>

        <!-- App label -->
        <div class="flex items-center gap-2 mb-8">
          <!-- Dumbbell icon -->
          <svg
            viewBox="0 0 24 24"
            class="w-4 h-4 shrink-0"
            style="color: var(--color-goal-muscle)"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="6" cy="12" r="3.5" fill="none" />
            <circle cx="18" cy="12" r="3.5" fill="none" />
            <line x1="9.5" y1="12" x2="14.5" y2="12" stroke-width="3" />
          </svg>
          <span
            class="text-[11px] font-bold uppercase tracking-[0.22em]"
            style="color: var(--color-goal-muscle)"
          >{t('appName')}</span>
        </div>

        <!-- MEGA heading -->
        <h1
          class="text-[72px] font-bold uppercase leading-[0.86] tracking-tight text-gym-text mb-5"
          style="font-family: var(--font-heading)"
        >
          {t('chooseGoalTitle')}
        </h1>

        <!-- Description -->
        <p class="text-[15px] text-gym-muted leading-relaxed mb-8 max-w-[280px]">
          {t('chooseGoalSubtitle')}
        </p>

        <!-- Stats strip -->
        <div class="flex border border-gym-border rounded-2xl overflow-hidden bg-gym-surface/50">
          <div class="flex-1 flex flex-col items-center justify-center py-4 border-r border-gym-border">
            <span
              class="text-[32px] font-bold leading-none"
              style="font-family: var(--font-heading); color: var(--color-goal-muscle)"
            >4</span>
            <span class="text-[10px] uppercase tracking-widest text-gym-muted mt-1">{labels.programs}</span>
          </div>
          <div class="flex-1 flex flex-col items-center justify-center py-4 border-r border-gym-border">
            <span
              class="text-[32px] font-bold leading-none"
              style="font-family: var(--font-heading); color: var(--color-goal-strength)"
            >5</span>
            <span class="text-[10px] uppercase tracking-widest text-gym-muted mt-1">{labels.days}</span>
          </div>
          <div class="flex-1 flex flex-col items-center justify-center py-4">
            <span
              class="text-[32px] font-bold leading-none"
              style="font-family: var(--font-heading); color: var(--color-goal-conditioning)"
            >36</span>
            <span class="text-[10px] uppercase tracking-widest text-gym-muted mt-1">{labels.exercises}</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ── GOAL CARDS ────────────────────────────────────────── -->
    <section class="px-4 pb-12" aria-label={t('trainingGoals')}>

      <!-- Section divider label -->
      <div class="flex items-center gap-3 mb-5">
        <div class="flex-1 h-px bg-gym-border"></div>
        <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-gym-muted whitespace-nowrap">
          {labels.selectPrompt}
        </span>
        <div class="flex-1 h-px bg-gym-border"></div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        {goals.map((g) => (
          <GoalCard goal={g.goal} displayName={g.displayName} href={g.href} lang={lang} />
        ))}
      </div>

    </section>

    <!-- ── FOOTER ─────────────────────────────────────────────── -->
    <footer class="px-4 pb-10 text-center">
      <p class="text-xs text-gym-muted">{t('footerNote')}</p>
    </footer>

  </body>
</html>
