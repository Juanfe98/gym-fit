---
import type { GetStaticPaths } from 'astro';
import type { Goal } from '../../../types';
import { ROUTINES } from '../../../data/routines';
import { EXERCISE_CATALOG } from '../../../data/exercises/catalog';
import { getExerciseByExerciseDbId } from '../../../services/exercise-lookup';
import ExerciseCard from '../../../components/ExerciseCard.astro';
import { languages, type Language, localizePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/ui';
import { getExerciseDisplayName, getGoalDisplayName } from '../../../i18n/content';
import '../../../styles/global.css';

const routineRefs = Object.values(ROUTINES).flatMap((routine) =>
  routine.days.flatMap((day) =>
    day.exercises.map((exercise) => ({ exercise, routine, day })),
  ),
);

export const getStaticPaths = (() => {
  const refs = Object.values(ROUTINES).flatMap((routine) =>
    routine.days.flatMap((day) =>
      day.exercises.map((exercise) => ({ exercise, routine, day })),
    ),
  );
  const ids = new Set(refs.map(({ exercise }) => EXERCISE_CATALOG[exercise.exerciseKey].exerciseDbId));
  return languages.flatMap((lang) => [...ids].map((id) => ({ params: { lang, id } })));
}) satisfies GetStaticPaths;

const { id } = Astro.params;
const lang = Astro.params.lang as Language;
const t = useTranslations(lang);
const exercise = getExerciseByExerciseDbId(id ?? '');
const match = routineRefs.find(({ exercise: ref }) => EXERCISE_CATALOG[ref.exerciseKey].exerciseDbId === id);
const localizedExerciseName = match ? getExerciseDisplayName(match.exercise.exerciseKey, lang) : '';
const localizedRoutineName  = match ? getGoalDisplayName(match.routine.goal, lang) : '';

if (!exercise || !match) {
  return Astro.redirect(localizePath(lang));
}

const accentColors: Record<Goal, string> = {
  'muscle-gain': '#F97316',
  strength:      '#EF4444',
  'fat-loss':    '#22C55E',
  conditioning:  '#3B82F6',
};
const accent = accentColors[match.routine.goal as Goal];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${localizedExerciseName} ${t('exerciseDescriptionSuffix')}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{localizedExerciseName} — Gym Planner</title>
  </head>

  <body class="min-h-screen bg-gym-bg text-gym-text overflow-x-hidden">

    <!-- Sticky nav with backdrop blur -->
    <header class="sticky top-0 z-20 bg-gym-bg/90 border-b border-gym-border" style="backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);">
      <div class="flex items-center justify-between px-4 max-w-lg mx-auto" style="min-height: 56px;">

        <a
          href={localizePath(lang, `/routine/${match.routine.goal}`)}
          class="inline-flex items-center gap-2 text-sm text-gym-muted active:text-gym-text transition-colors duration-200 min-h-[44px] cursor-pointer"
        >
          <svg viewBox="0 0 24 24" class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
          <span class="truncate max-w-[160px]">{localizedRoutineName}</span>
        </a>

        <div class="inline-flex items-center gap-1 bg-gym-surface border border-gym-border rounded-lg p-1 shrink-0" aria-label="Language">
          <a href={`/en/exercise/${id}`} class={`text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md transition-colors duration-200 ${lang === 'en' ? 'bg-gym-border text-gym-text' : 'text-gym-muted'}`}>EN</a>
          <a href={`/es/exercise/${id}`} class={`text-[11px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md transition-colors duration-200 ${lang === 'es' ? 'bg-gym-border text-gym-text' : 'text-gym-muted'}`}>ES</a>
        </div>

      </div>
    </header>

    <!-- Exercise card — full-bleed, no outer px -->
    <main class="pb-14 max-w-lg mx-auto">
      <ExerciseCard
        exercise={exercise}
        routine={match.routine}
        day={match.day}
        routineRef={match.exercise}
        lang={lang}
        accentColor={accent}
      />
    </main>

  </body>
</html>
