---
import type { GetStaticPaths } from 'astro';
import type { Goal } from '../../types';
import { ROUTINES } from '../../data/routines/index';
import RoutineDay from '../../components/RoutineDay.astro';
import '../../styles/global.css';

export const getStaticPaths = (() => {
  return (Object.keys(ROUTINES) as Goal[]).map((goal) => ({
    params: { goal },
  }));
}) satisfies GetStaticPaths;

const { goal } = Astro.params;
const routine = ROUTINES[goal as Goal];

const accentColors: Record<Goal, string> = {
  'muscle-gain': '#F97316',
  strength: '#EF4444',
  'fat-loss': '#22C55E',
  conditioning: '#3B82F6',
};

const accent = accentColors[goal as Goal];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${routine.displayName} weekly training routine.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{routine.displayName} Routine — Gym Planner</title>
  </head>
  <body class="min-h-screen bg-gym-bg text-gym-text">
    <main class="px-4 pt-6 pb-12 max-w-lg mx-auto">

      <!-- Back nav -->
      <nav class="mb-6">
        <a
          href="/"
          class="inline-flex items-center gap-1.5 text-sm text-gym-muted active:text-gym-text transition-colors duration-150 min-h-[44px]"
          aria-label="Back to goal selection"
        >
          <svg
            viewBox="0 0 24 24"
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
          All Goals
        </a>
      </nav>

      <!-- Page header -->
      <header class="mb-6">
        <p
          class="text-xs font-semibold uppercase tracking-widest mb-1"
          style={`color: ${accent}`}
        >
          Weekly Routine
        </p>
        <h1
          class="text-4xl font-bold uppercase leading-none tracking-wide text-gym-text"
          style="font-family: var(--font-heading)"
        >
          {routine.displayName}
        </h1>
      </header>

      <!-- Rationale -->
      <section
        class="mb-8 rounded-xl bg-gym-surface border border-gym-border p-4"
        aria-label="Routine rationale"
        style={`border-left: 3px solid ${accent}`}
      >
        <p class="text-sm text-gym-muted leading-relaxed">
          {routine.rationale}
        </p>
      </section>

      <!-- Training days -->
      <section aria-label="Training days">
        <h2
          class="text-xs font-semibold uppercase tracking-widest text-gym-muted mb-4"
        >
          {routine.days.length}-Day Schedule
        </h2>
        <div class="flex flex-col gap-4">
          {routine.days.map((day) => (
            <RoutineDay routine={routine} day={day} goal={goal as Goal} />
          ))}
        </div>
      </section>

    </main>
  </body>
</html>
