---
import type { Goal } from '../types';
import { ROUTINES } from '../data/routines/index';
import GoalCard from '../components/GoalCard.astro';
import { localizePath } from '../i18n/config';
import '../styles/global.css';

const goals = (Object.keys(ROUTINES) as Goal[]).map((slug) => ({
  goal: slug,
  displayName: ROUTINES[slug].displayName,
  href: localizePath('en', `/routine/${slug}`),
}));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Science-backed weekly training routines for intermediate to advanced gym-goers." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>Gym Planner — Choose Your Goal</title>
  </head>
  <body class="min-h-screen bg-gym-bg text-gym-text">
    <main class="px-4 py-10 max-w-lg mx-auto">

      <nav class="flex justify-end gap-2 mb-6 text-sm" aria-label="Language">
        <a class="text-gym-text font-semibold" href="/en">EN</a>
        <span class="text-gym-muted">/</span>
        <a class="text-gym-muted" href="/es">ES</a>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-goal-muscle mb-2">
          Gym Planner
        </p>
        <h1
          class="text-4xl font-bold uppercase leading-none tracking-wide text-gym-text"
          style="font-family: var(--font-heading)"
        >
          What's Your Goal?
        </h1>
        <p class="mt-2 text-gym-muted text-sm leading-relaxed">
          Select a goal to get your complete weekly routine.
        </p>
      </header>

      <!-- Goal grid -->
      <section aria-label="Training goals">
        <div class="grid grid-cols-2 gap-3">
          {goals.map((g) => (
            <GoalCard goal={g.goal} displayName={g.displayName} href={g.href} lang="en" />
          ))}
        </div>
      </section>

      <!-- Footer note -->
      <p class="mt-10 text-center text-xs text-gym-muted">
        Intermediate to advanced · No account required
      </p>

    </main>
  </body>
</html>
