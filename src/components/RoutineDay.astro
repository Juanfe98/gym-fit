---
import type { Goal, Routine, TrainingDay } from '../types';
import { getExercisePageId } from '../services/exercise-lookup';
import { defaultLanguage, type Language, localizePath } from '../i18n/config';
import { getExerciseDisplayName, getLocalizedDayLabel } from '../i18n/content';
import { getDayFocus } from '../i18n/routine-content';

interface Props {
  routine: Routine;
  day: TrainingDay;
  goal: Goal;
  lang?: Language;
}

const { routine, day, goal, lang = defaultLanguage } = Astro.props;

const accentColors: Record<Goal, string> = {
  'muscle-gain': '#F97316',
  strength: '#EF4444',
  'fat-loss': '#22C55E',
  conditioning: '#3B82F6',
};

const accent = accentColors[goal];
---

<article
  class="rounded-xl bg-gym-surface border border-gym-border overflow-hidden"
  aria-label={`${getLocalizedDayLabel(day.label, lang)}: ${getDayFocus(routine, day, lang)}`}
>
  <!-- Header -->
  <header
    class="px-4 pt-4 pb-3 border-b border-gym-border"
    style={`border-left: 3px solid ${accent}`}
  >
    <div class="flex items-baseline gap-3">
      <span
        class="text-2xl font-bold uppercase tracking-wider leading-none"
        style={`font-family: var(--font-heading); color: ${accent}`}
      >
        {getLocalizedDayLabel(day.label, lang)}
      </span>
      <span class="text-sm text-gym-muted leading-none">
        {getDayFocus(routine, day, lang)}
      </span>
    </div>
  </header>

  <!-- Exercise list -->
  <ol class="divide-y divide-gym-border">
    {day.exercises.map((exercise, index) => (
      <li>
        <a
          href={localizePath(lang, `/exercise/${getExercisePageId(exercise.exerciseKey)}`)}
          class="
            flex items-center gap-3 px-4
            min-h-[52px] w-full
            text-gym-text
            transition-colors duration-150
            active:bg-white/5
            focus-visible:outline-none focus-visible:ring-inset focus-visible:ring-2
            cursor-pointer
          "
          style={`--focus-ring: ${accent}`}
        >
          <!-- Number badge -->
          <span
            class="shrink-0 w-6 h-6 flex items-center justify-center rounded-full text-xs font-bold leading-none"
            style={`background: ${accent}22; color: ${accent}; font-family: var(--font-heading)`}
            aria-hidden="true"
          >
            {index + 1}
          </span>

          <!-- Name -->
          <span class="flex-1 text-base font-medium leading-snug">
            {getExerciseDisplayName(exercise.exerciseKey, lang)}
          </span>

          <!-- Arrow -->
          <svg
            viewBox="0 0 24 24"
            class="shrink-0 w-4 h-4 text-gym-muted"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </a>
      </li>
    ))}
  </ol>
</article>
