---
import type { Exercise, ExerciseRef, Routine, TrainingDay } from '../types';
import MuscleDiagram from './MuscleDiagram.astro';
import { defaultLanguage, type Language } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getEquipmentLabel, getExerciseDisplayName, getMuscleLabel } from '../i18n/content';
import { getExerciseCommonMistakes, getExerciseFormCues, getExerciseRationale } from '../i18n/routine-content';

interface Props {
  exercise:    Exercise;
  routine:     Routine;
  day:         TrainingDay;
  routineRef:  ExerciseRef;
  lang?:       Language;
  accentColor?: string;
}

const {
  exercise,
  routine,
  day,
  routineRef,
  lang = defaultLanguage,
  accentColor = '#F97316',
} = Astro.props;

const t                 = useTranslations(lang);
const exerciseDisplayName = getExerciseDisplayName(routineRef.exerciseKey, lang);
const formCues          = getExerciseFormCues(routine, day, routineRef, lang);
const commonMistakes    = getExerciseCommonMistakes(routine, day, routineRef, lang);
const rationale         = getExerciseRationale(routine, day, routineRef, lang);
---

<article>

  <!-- ── GIF — full-bleed, fixed aspect so layout never jumps ── -->
  <div class="relative bg-black" style="aspect-ratio: 4/3; overflow: hidden;">
    <img
      src={exercise.gifUrl}
      alt={`${exerciseDisplayName} ${t('exerciseDemo')}`}
      class="w-full h-full object-contain"
      loading="eager"
      decoding="async"
      width="400"
      height="300"
    />
    <!-- Bottom fade into content -->
    <div
      aria-hidden="true"
      class="absolute inset-x-0 bottom-0 h-20 pointer-events-none"
      style="background: linear-gradient(to bottom, transparent, #0F172A);"
    />
  </div>

  <!-- ── CONTENT ──────────────────────────────────────────────── -->
  <div class="px-4 pt-5 pb-2">

    <!-- Tags row -->
    <div class="flex flex-wrap gap-2 mb-3">
      <!-- Equipment tag -->
      <span class="inline-flex items-center gap-1.5 rounded-full border border-gym-border bg-gym-surface px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-gym-muted">
        <svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <path d="M9 9h6M9 12h6M9 15h4" />
        </svg>
        {getEquipmentLabel(exercise.equipment, lang)}
      </span>
      <!-- Primary muscle tag — goal-accent tinted -->
      <span
        class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-wide"
        style={`border: 1px solid ${accentColor}44; background: ${accentColor}14; color: ${accentColor}`}
      >
        <svg viewBox="0 0 24 24" class="w-3 h-3 shrink-0" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" />
        </svg>
        {getMuscleLabel(exercise.target, lang)}
      </span>
    </div>

    <!-- Exercise name -->
    <h1
      class="text-[48px] font-bold uppercase leading-[0.88] tracking-tight text-gym-text mb-6"
      style="font-family: var(--font-heading)"
    >
      {exerciseDisplayName}
    </h1>

    <!-- Divider -->
    <div class="h-px bg-gym-border mb-6"></div>

    <!-- Why it's here -->
    <section class="mb-6">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-1 h-4 rounded-full shrink-0" style={`background: ${accentColor}`} aria-hidden="true"></div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-gym-muted">{t('whyItIsHere')}</h2>
      </div>
      <p class="text-sm text-gym-muted leading-relaxed pl-3.5">{rationale}</p>
    </section>

    <!-- Muscles -->
    <section class="mb-6">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-1 h-4 rounded-full shrink-0" style={`background: ${accentColor}`} aria-hidden="true"></div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-gym-muted">{t('muscles')}</h2>
      </div>
      <div class="rounded-xl bg-gym-surface border border-gym-border p-3">
        <MuscleDiagram primary={[exercise.target]} secondary={exercise.secondaryMuscles} lang={lang} />
      </div>
    </section>

    <!-- Form cues — numbered with accent badges -->
    <section class="mb-6">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-1 h-4 rounded-full shrink-0" style={`background: ${accentColor}`} aria-hidden="true"></div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-gym-muted">{t('formCues')}</h2>
      </div>
      <ol class="space-y-3">
        {formCues.map((cue, i) => (
          <li class="flex items-start gap-3">
            <span
              class="shrink-0 w-5 h-5 flex items-center justify-center rounded-full text-[10px] font-bold leading-none mt-0.5"
              style={`background: ${accentColor}22; color: ${accentColor}; font-family: var(--font-heading)`}
              aria-hidden="true"
            >{i + 1}</span>
            <span class="text-sm text-gym-muted leading-relaxed flex-1">{cue}</span>
          </li>
        ))}
      </ol>
    </section>

    <!-- Common mistakes — red-tinted numbered badges -->
    <section class="pb-6">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-1 h-4 rounded-full shrink-0 bg-red-500" aria-hidden="true"></div>
        <h2 class="text-[11px] font-bold uppercase tracking-[0.18em] text-gym-muted">{t('commonMistakes')}</h2>
      </div>
      <ol class="space-y-3">
        {commonMistakes.map((mistake, i) => (
          <li class="flex items-start gap-3">
            <span
              class="shrink-0 w-5 h-5 flex items-center justify-center rounded-full text-[10px] font-bold leading-none mt-0.5"
              style="background: rgba(239,68,68,0.18); color: #EF4444; font-family: var(--font-heading)"
              aria-hidden="true"
            >{i + 1}</span>
            <span class="text-sm text-gym-muted leading-relaxed flex-1">{mistake}</span>
          </li>
        ))}
      </ol>
    </section>

  </div>
</article>
